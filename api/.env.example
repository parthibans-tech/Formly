DATABASE_URL=postgres://drive360:drive360@localhost:5432/drive360?sslmode=disable
JWT_SECRET=dev-secret-change-me

MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=drive360
MINIO_SSL=false

# ---------------------- AI (optional) ----------------------------
# AI features are OFF by default. Set AI_ENABLED=1 to turn them on;
# the API will boot identically without these vars set, and the
# /v1/ai/config endpoint will report `enabled:false` so the frontend
# hides every AI affordance.
#
# Default provider in dev is Ollama, which is wired into
# infra/docker-compose.yml (service `ollama`, host-published on
# 11434). Pulled models: llama3.1:8b (chat), nomic-embed-text (embed).
#
# AI_ENABLED=1
# AI_PROVIDER=ollama          # ollama | vllm | anthropic
# AI_BASE_URL=http://localhost:11434
# AI_CHAT_MODEL=llama3.1:8b
# AI_EMBED_MODEL=nomic-embed-text
# AI_API_KEY=                 # required for anthropic; optional for vllm
# AI_TIMEOUT_SEC=180          # per-request timeout. Default 180s
                              # covers ollama cold loads (model →
                              # RAM) on small machines. Lower for
                              # hosted providers like anthropic.
#
# AI_VISION_MODEL=llava:13b   # OPTIONAL. Enables the third tier of
                              # auto-field-detection (vision-LLM) for
                              # scanned/flat PDFs the OCR-driven
                              # heuristic can't read. Required for
                              # ollama / vllm to advertise vision
                              # capability; ignored on anthropic
                              # (Claude vision works through the
                              # same Messages endpoint as chat, no
                              # second model name needed).
                              #
                              # Recommended models per provider:
                              #   ollama:    llava:13b, qwen2-vl, minicpm-v
                              #   vllm:      Qwen2-VL-7B-Instruct,
                              #              llava-hf/llava-1.6-mistral-7b-hf
                              #   anthropic: (no override needed —
                              #              AI_CHAT_MODEL is also the
                              #              vision model)

# ---------------------- OCR (optional) ---------------------------
# Powers Summarize / Ask on scanned PDFs and image uploads (PAN,
# Aadhaar, receipts, etc.). Off by default; when disabled the docchat
# handler 415s on images and on PDFs with no text layer.
#
# OCR runs in a sidecar service (PaddleOCR + PP-Structure, see
# infra/paddle-ocr/). Bring it up alongside the rest of the dev
# stack with:
#
#   docker compose -f infra/docker-compose.yml up -d paddle-ocr
#
# It listens on host port 8868 by default. The api speaks HTTP to it
# at PADDLE_OCR_URL — the Go process never invokes a local OCR binary.
#
# OCR_LANG uses PaddleOCR's ISO codes ("en", "hi", "ta", "ch", "ja",
# "ko", "fr", ...). Multi-language is "+"-joined for backwards
# compatibility with the previous tesseract config (e.g. "en+hi");
# the sidecar splits and runs the primary language. Legacy tesseract
# codes ("eng", "hin", "tam") are auto-aliased.
#
# OCR_ENABLED=1
# PADDLE_OCR_URL=http://localhost:8868
# OCR_LANG=en
# OCR_MAX_PAGES=30
# OCR_DPI=200
# OCR_PER_PAGE_TIMEOUT_SEC=30
 
# ---------------------- Observability (optional) -----------------
# When PROMETHEUS_URL is set, /v1/admin/observability/{snapshot,series}
# light up — the super-admin Observability page renders live cards
# and sparklines on top of the static reference. Without it, those
# endpoints return a clean prom_unconfigured 503 and the page falls
# back to the static SLO/runbook reference.
#
# The dev stack ships a Prometheus container at host port 9091 (the
# worker /metrics already owns 9090). Bring it up alongside the
# rest with: docker compose -f infra/docker-compose.yml up -d prometheus
#
# Optional basic auth — only needed when you've also set
# METRICS_BASIC_AUTH_USER / METRICS_BASIC_AUTH_PASSWORD on the
# scraped processes, which we do NOT in dev (loopback-only fallback).
#
# PROMETHEUS_URL=http://localhost:9091
# PROMETHEUS_USER=
# PROMETHEUS_PASSWORD=

# ---------------------- Alertmanager (optional) ------------------
# Surfaces alert dispatch state (silenced, inhibited, forwarded)
# in the dashboard. Alerts still fire from Prometheus without it.
#
# ALERTMANAGER_URL=http://localhost:9093

# ---------------------- Tracing — OpenTelemetry / Tempo ----------
# When OTEL_EXPORTER_OTLP_ENDPOINT is set, the API + worker emit
# spans via OTLP/HTTP. The dev compose stack ships a Tempo
# container at :4318 (OTLP/HTTP). The HTTP histogram exemplars
# (api/internal/metrics) carry the same trace_id, so an exemplar
# click in Grafana resolves to the captured span.
#
# Set OTEL_DISABLED=1 to force-off even when an endpoint is set
# (useful when triaging a tracing-induced perf issue).
#
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=formly-api
# OTEL_TRACES_SAMPLER_ARG=1.0
# OTEL_DISABLED=

# ---------------------- Grafana (optional) -----------------------
# Operator dashboards. Probed for the observability page's infra
# strip ("is Grafana up?"). Container binds :3000 but the dev
# compose stack maps it to host :3001 (the Next.js app already
# uses :3000).
#
# GRAFANA_URL=http://localhost:3001

# ---------------------- Blackbox exporter (optional) -------------
# Synthetic HTTP/TCP/DNS probes. Prometheus drives the actual
# scrapes; this URL is only consumed by the dashboard infra strip
# to surface "is the probe runner up?".
#
# BLACKBOX_URL=http://localhost:9115

# ---------------------- Loki (optional) --------------------------
# Centralized logs. Probed for the observability infra strip;
# Grafana queries Loki directly for the Logs Explorer dashboard.
#
# LOKI_URL=http://localhost:3100

# ---------------------- Pyroscope (optional) ---------------------
# Continuous profiling. The dev compose stack ships Pyroscope on
# :4040; it pull-scrapes /debug/pprof/* from the API + worker, so
# the Go binaries don't link any Pyroscope SDK — they just expose
# the standard runtime/pprof handlers behind the same access
# guard as /metrics. The infra strip probes /ready.
#
# PYROSCOPE_URL=http://localhost:4040

# ---------------------- Infrastructure exporters (optional) ------
# postgres_exporter, redis_exporter, cAdvisor. Prometheus scrapes
# them directly via the dev compose stack — these env vars only
# control whether they show up on the observability page's infra
# strip.
#
# POSTGRES_EXPORTER_URL=http://localhost:9187
# REDIS_EXPORTER_URL=http://localhost:9121
# CADVISOR_URL=http://localhost:8081

# FORMLY_VERSION=
# FORMLY_ENV=dev

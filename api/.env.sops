# ─── ONLYOFFICE Document Server ───
# Shared with the docker-compose service (compose reads
# ONLYOFFICE_JWT_SECRET via interpolation, defaulting to
# "dev-onlyoffice-secret"). Keep these matched.
#
# PUBLIC_URL is browser-facing (loads api.js).
# INTERNAL_API_URL is how the doc server container reaches our API for
# content fetch + save callback. host.docker.internal works on Docker
# Desktop (macOS / Windows); on Linux the compose file's extra_hosts
# entry covers the same hostname.
ONLYOFFICE_JWT_SECRET=ENC[AES256_GCM,data:VbmP6ALcTF9FSwAlE5+dxjf1PpXd,iv:3rm1FGgBOFLFWMtERw5kh++cXhkIoczc8+4t0EjJi3U=,tag:DzzmQWml+QWEYyg2KNkhvg==,type:str]
ONLYOFFICE_PUBLIC_URL=http://localhost:8090
ONLYOFFICE_INTERNAL_API_URL=http://host.docker.internal:8080
# ─── AI ───
# Smart search + AI features. Provider defaults to Ollama running in
# the compose stack on localhost:11434 (see infra/docker-compose.yml).
# Models match what `ollama-init` pre-pulls so the first request
# doesn't stall on a multi-GB download.
#
# Flip AI_ENABLED back to 0 (or comment it out) to fully turn AI off:
# the API boots identically, /v1/ai/config reports enabled:false, and
# the frontend hides every AIFeature-gated affordance.
AI_ENABLED=1
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434
# Switched from llama3.1:8b → llama3.2:3b: the 8B model needs ~4.8 GiB
# of RAM and ollama refuses to load it on machines with less free.
# 3B fits in ~2.5 GiB, summarizes/answers comparably for short docs,
# and starts much faster. Bump back to 8B (or larger) on a beefier
# host if you want better long-context quality.
AI_CHAT_MODEL=llama3.2:3b
AI_EMBED_MODEL=nomic-embed-text
# ─── OCR (optional) ───
# Enables Summarize / Ask on scanned PDFs and image uploads (PAN,
# Aadhaar, receipts, handwritten notes). Off-by-default — when
# OCR_ENABLED is unset or 0 the docchat handler returns 415 for
# image/* and for PDFs whose primary text extractor returned empty.
#
# Requires two binaries on PATH:
#   macOS:  brew install tesseract poppler tesseract-lang
#   Linux:  apt-get install -y tesseract-ocr poppler-utils tesseract-ocr-hin
#
# OCR_LANG follows tesseract's "+"-joined syntax. eng+hin covers the
# Devanagari side of an Aadhaar card; add more (eng+hin+tam, etc.) as
# you onboard regional ID docs. Each extra language slows tesseract
# slightly and costs ~5-15 MB of RAM per worker.
OCR_ENABLED=1
OCR_LANG=eng+hin
# PSM 6 (single uniform block of text) consistently beats the default
# PSM 3 on ID cards, receipts, and most single-block scans — tesseract
# stops searching for non-existent columns/headers and pays full
# attention to the actual text. Flip back to 3 if you start ingesting
# multi-column documents (newspaper scans, complex forms).
OCR_PSM=6
# Preprocessing pipeline (auto-orient, deskew, grayscale, normalize,
# sharpen) runs through ImageMagick before tesseract sees the image.
# Default on; set to 0 to debug raw tesseract behaviour.
OCR_PREPROCESS=1
# OCR_MAX_PAGES=30           # cap pages rasterized from a scanned PDF
# OCR_DPI=200                # higher = better quality, slower + more RAM
# OCR_PER_PAGE_TIMEOUT_SEC=30

# Why legacy-peer-deps:
#   The @blocknote stack peer-requires @tiptap/pm@3.x, but the rest
#   of the project pins @tiptap/pm@^2.x. npm 7+ rejects this; npm 6
#   silently allowed it. The lockfile was generated under the
#   permissive resolver — pin that resolver here so `npm ci` (Docker
#   build, CI) and `npm install` (local dev) behave the same.
#
#   Long-term fix: bump @tiptap/pm to ^3 and re-resolve the tree.
#   Until then this keeps the build green.
legacy-peer-deps=true

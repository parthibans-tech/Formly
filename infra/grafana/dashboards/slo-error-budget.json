{
  "annotations": {"list": []},
  "description": "30-day error-budget burndown per tier. The on-call's 'do we have headroom for the next risky deploy?' view — separate from slo-burn.json which is the right-now multi-window burn-rate view. Shows budget remaining as a percentage, the exhaustion forecast in days, and the absolute consumed/allowed error counts so a budget conversation has numbers attached.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "row",
      "title": "30-day error budget — at a glance",
      "id": 100,
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1}
    },
    {
      "type": "stat",
      "title": "Budget remaining (per tier)",
      "id": 1,
      "gridPos": {"x": 0, "y": 1, "w": 12, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "tier:formly_error_budget_remaining:ratio30d",
          "legendFormat": "{{tier}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 0.25},
              {"color": "green", "value": 0.5}
            ]
          }
        }
      },
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center"}
    },
    {
      "type": "stat",
      "title": "Forecast: days until budget exhausted (per tier, 6h projection)",
      "id": 2,
      "gridPos": {"x": 12, "y": 1, "w": 12, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "clamp(tier:formly_error_budget_exhaustion_seconds:predict30d / 86400, 0, 999)",
          "legendFormat": "{{tier}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 7},
              {"color": "green", "value": 30}
            ]
          },
          "noValue": "n/a"
        }
      },
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center"}
    },
    {
      "type": "row",
      "title": "Burndown trend",
      "id": 200,
      "gridPos": {"x": 0, "y": 6, "w": 24, "h": 1}
    },
    {
      "type": "timeseries",
      "title": "30d budget remaining over time (per tier)",
      "id": 3,
      "gridPos": {"x": 0, "y": 7, "w": 24, "h": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "tier:formly_error_budget_remaining:ratio30d",
          "legendFormat": "{{tier}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": -0.25,
          "max": 1.0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 0.25},
              {"color": "green", "value": 0.5}
            ]
          }
        }
      }
    },
    {
      "type": "row",
      "title": "Volume — what's behind the percentage",
      "id": 300,
      "gridPos": {"x": 0, "y": 16, "w": 24, "h": 1}
    },
    {
      "type": "table",
      "title": "Per-tier: 5xx used / budget over the last 30d",
      "id": 4,
      "gridPos": {"x": 0, "y": 17, "w": 24, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "tier:formly_tenant_requests:total30d",
          "legendFormat": "requests",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "tier:formly_tenant_5xx:total30d",
          "legendFormat": "5xx_used",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "tier:formly_tenant_5xx:budget30d",
          "legendFormat": "5xx_budget",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "tier:formly_error_budget_remaining:ratio30d",
          "legendFormat": "budget_remaining",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {"byField": "tier", "mode": "outer"}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true, "Time 1": true, "Time 2": true, "Time 3": true, "Time 4": true, "__name__": true},
            "renameByName": {
              "Value #A": "requests (30d)",
              "Value #B": "5xx used",
              "Value #C": "5xx budget (0.5%)",
              "Value #D": "budget remaining"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short", "decimals": 0},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "budget remaining"},
            "properties": [
              {"id": "unit", "value": "percentunit"},
              {"id": "decimals", "value": 2},
              {"id": "custom.cellOptions", "value": {"type": "color-background"}},
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {"color": "red", "value": null},
                    {"color": "orange", "value": 0.25},
                    {"color": "green", "value": 0.5}
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "row",
      "title": "Read vs write — separate budgets",
      "id": 400,
      "gridPos": {"x": 0, "y": 25, "w": 24, "h": 1}
    },
    {
      "type": "timeseries",
      "title": "Per-tier 5xx ratio (1h, by kind)",
      "id": 5,
      "gridPos": {"x": 0, "y": 26, "w": 24, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "tier_kind:formly_tenant_error_ratio:rate1h",
          "legendFormat": "{{tier}} · {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {"drawStyle": "line", "fillOpacity": 8}
        }
      }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["formly", "slo", "budget"],
  "templating": {"list": []},
  "time": {"from": "now-30d", "to": "now"},
  "timepicker": {},
  "timezone": "",
  "title": "Formly · SLO error budget (30d)",
  "uid": "formly-slo-budget-30d",
  "version": 1,
  "weekStart": ""
}

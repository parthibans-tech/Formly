# formly-api@.service — parameterized template for the blue-green
# deploy pattern. Start two instances by name:
#
#   systemctl start formly-api@blue     # listens on 127.0.0.1:8080
#   systemctl start formly-api@green    # listens on 127.0.0.1:8081
#
# Only ONE slot serves production traffic at a time — nginx's
# upstream config (see /etc/nginx/snippets/formly-api-upstream.conf)
# decides which. Deploys land in the IDLE slot, are health-checked,
# then nginx is swapped in a single atomic file rename + reload.
#
# `%i` in this file expands to the instance name (blue / green) at
# unit-resolution time. We use it to:
#   • pick the right slot directory (each slot has its own symlink
#     into /opt/formly/api/releases/<VERSION>)
#   • load a slot-specific env file that pins LISTEN_ADDR to the
#     right port — the API binary reads $LISTEN_ADDR at boot.
#
# Layout this unit expects:
#
#   /opt/formly/api/
#     env                 — shared (DATABASE_URL, JWT_SECRET, AI_*)
#     env.blue            — LISTEN_ADDR=127.0.0.1:8080
#     env.green           — LISTEN_ADDR=127.0.0.1:8081
#     slots/
#       blue/             → symlink to releases/<VERSION_X>
#       green/            → symlink to releases/<VERSION_Y>
#     releases/<VERSION>/
#       formly-api
#       migrations/

[Unit]
Description=Formly API (slot %i)
Documentation=https://github.com/your-org/formly
After=network-online.target postgresql.service redis.service ollama.service
Wants=network-online.target ollama.service

[Service]
Type=simple
User=formly
Group=formly

# WorkingDirectory must be the slot's release dir because
# runMigrations() globs `migrations/*.sql` relative to cwd. Both
# slots typically point at the same release after a deploy
# completes, but during a deploy they can diverge — that's the whole
# point (idle slot is the rollback target).
WorkingDirectory=/opt/formly/api/slots/%i
ExecStart=/opt/formly/api/slots/%i/formly-api

# Two EnvironmentFile directives: shared first, then slot-specific.
# Later files override earlier ones, so env.<slot> can pin
# LISTEN_ADDR without the shared file needing per-slot variants.
EnvironmentFile=/opt/formly/api/env
EnvironmentFile=/opt/formly/api/env.%i

Restart=on-failure
RestartSec=2
StartLimitIntervalSec=60
StartLimitBurst=10

# Hardening (same profile as before).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
ReadWritePaths=/var/log/formly /var/lib/formly /opt/formly/api/releases /opt/formly/api/slots

# On a 2-core / 8 GB KVM 2 we cap each slot at 1 GB. Both slots
# overlapping for ~30 s during a swap = peak 2 GB API footprint,
# leaving room for Postgres + Ollama + OCR bursts.
LimitNOFILE=65536
MemoryMax=1G

# Graceful shutdown. The deploy script sends SIGTERM, expects the
# server to drain in-flight requests within TimeoutStopSec, then
# systemd SIGKILLs. Net's default ListenAndServe doesn't drain on
# its own — that's a known gap; tracked separately. The 30 s grace
# period below is empirical headroom for the longest in-flight call
# (a multi-page OCR + summarize chain).
KillSignal=SIGTERM
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target

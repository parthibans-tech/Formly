# Formly Caddyfile — public reverse proxy with automatic Let's
# Encrypt TLS.
#
# Domains come from environment variables (set in .env):
#   DOMAIN_WEB      e.g. drive360.nearbyme.app
#   DOMAIN_API      e.g. api.drive360.nearbyme.app
#   DOMAIN_OFFICE   e.g. office.drive360.nearbyme.app  (optional)
#   DOMAIN_S3       e.g. s3.drive360.nearbyme.app       (optional)
#   ACME_EMAIL      e.g. you@nearbyme.app
#
# How TLS works:
#   On first request to each domain, Caddy:
#     1. Asks Let's Encrypt for a cert via HTTP-01 challenge.
#     2. LE hits http://<domain>/.well-known/acme-challenge/...
#     3. Caddy responds, gets the cert, stores it in /data
#        (mounted as the caddy_data volume — DON'T LOSE THIS).
#     4. Subsequent requests use the cert; renewal happens
#        automatically ~30 days before expiry.
#
# DNS prerequisite: each domain's A record must already point at
# this VPS before Caddy is started. Otherwise the ACME challenge
# fails and Caddy retries with backoff (you'll see TLS errors).

{
    email {$ACME_EMAIL}
    # Auto-HTTPS is on by default — Caddy redirects 80 → 443 itself.

    # Servers block sets HTTP/3 + sensible defaults.
    servers {
        protocols h1 h2 h3
    }
}

# ─────────────────────────────────────────────────────────────
# Web — the Next.js app
# ─────────────────────────────────────────────────────────────
{$DOMAIN_WEB} {
    encode zstd gzip

    # Static assets — let Caddy hold them for a year. Next.js
    # content-hashes filenames under /_next/static so this is safe.
    @static path /_next/static/*
    handle @static {
        header Cache-Control "public, max-age=31536000, immutable"
        reverse_proxy web:3000
    }

    # Everything else proxies through to Next.
    reverse_proxy web:3000 {
        # Forward real client IP and proto so Next sees the public
        # URL, not the docker bridge IP.
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Body size for any uploads done via the SSR path. The actual
    # upload route is on the API; this is just defensive.
    request_body {
        max_size 25MB
    }
}

# ─────────────────────────────────────────────────────────────
# API — Go service
# ─────────────────────────────────────────────────────────────
{$DOMAIN_API} {
    encode zstd gzip

    # OCR uploads can be a few MB (multi-page PDFs). 25 MB matches
    # the API's own MaxUploadSize — keep them in sync.
    request_body {
        max_size 25MB
    }

    reverse_proxy api:8080 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # AI summarise / Ollama chains can take 60+ seconds. Default
        # Caddy timeout is generous but make it explicit.
        transport http {
            response_header_timeout 120s
            read_timeout 120s
        }
    }
}

# ─────────────────────────────────────────────────────────────
# ONLYOFFICE (optional) — only routed if DOMAIN_OFFICE is set.
# Browsers iframe-load the editor SPA from this domain, so it MUST
# be public + HTTPS.
# ─────────────────────────────────────────────────────────────
{$DOMAIN_OFFICE} {
    encode zstd gzip
    reverse_proxy onlyoffice:80 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        # ONLYOFFICE uses websockets for collab + status pings.
        # Caddy auto-detects the Upgrade header but we make it
        # explicit so anyone reading this config sees it.
    }
}

# ─────────────────────────────────────────────────────────────
# MinIO public bucket access (optional) — set DOMAIN_S3 in .env.
# Use this if browsers do presigned uploads/downloads directly.
# ─────────────────────────────────────────────────────────────
{$DOMAIN_S3} {
    encode zstd gzip
    reverse_proxy minio:9000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
    # Object uploads can be large.
    request_body {
        max_size 100MB
    }
}

# Formly compose .env — copy to .env on the VPS and fill in real
# values. Loaded automatically by `docker compose` from the same
# directory as docker-compose.yml.
#
# CHMOD THIS FILE 600 — it contains every secret in the system.
# ════════════════════════════════════════════════════════════
# DOMAINS  (must have DNS A records pointing at this VPS)
# ════════════════════════════════════════════════════════════
DOMAIN_WEB=drive360.nearbyme.app
DOMAIN_API=api.drive360.nearbyme.app
# Optional — only set if you want public access. Leave blank to
# skip the corresponding Caddy block.
DOMAIN_OFFICE=
DOMAIN_S3=
ACME_EMAIL=parthiban@drive360.com
# ════════════════════════════════════════════════════════════
# CONTAINER IMAGES  (rewritten by CI on every deploy)
# ════════════════════════════════════════════════════════════
# These default to :latest from your registry. CI pins them to a
# specific tag (e.g. ghcr.io/you/formly-api:1.0.5) and writes the
# values into this file before `docker compose up -d`.
API_IMAGE=ghcr.io/your-github-username/formly-api:latest
WEB_IMAGE=ghcr.io/your-github-username/formly-web:latest
IMAGE_TAG=latest
# ════════════════════════════════════════════════════════════
# DATABASE
# ════════════════════════════════════════════════════════════
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=ENC[AES256_GCM,data:6XTquKhpSSmuTOAWjMrBwd93xbFXGR1Pis/yDTiWztlM16OYxLRsuoRJ6OFFhP2P,iv:VPalYDlQut8nWfgyqPr3CsTFCYkjxzmV23Ea9vCY+Ks=,tag:VzGu4XQ82jH5q+Ig1FBDiw==,type:str]
# ════════════════════════════════════════════════════════════
# AUTH
# ════════════════════════════════════════════════════════════
# Generate: openssl rand -hex 32
JWT_SECRET=ENC[AES256_GCM,data:3FMEcatSK786X+Zg3fK2a9p1fWwqlGqoYj6jR0c8+jnqTdU56L6CKA++XDw6bRJDHmLlX+2epjaprrcxMtmdqQ==,iv:L9e/DH/3FmjO5EXdHuKSjtYmzM/XOlVqcX+f70Usk5I=,tag:9AGzsjVMteBVMcuM8SFPgA==,type:str]
# Org UUID whose admins pass requireSuperAdmin guards. Leave blank
# to make every org admin a super-admin (dev shortcut). In prod set
# to the operator org's UUID — find it with:
#   docker compose exec postgres psql -U formly -d formly \
#     -c "select id from organizations where slug='your-platform-org';"
PLATFORM_ROOT_ORG_ID=
# ════════════════════════════════════════════════════════════
# OBJECT STORAGE  (MinIO)
# ════════════════════════════════════════════════════════════
# Generate user: openssl rand -hex 12
# Generate pass: openssl rand -hex 24
MINIO_ROOT_USER=ENC[AES256_GCM,data:nuz9eBIDEMWMOKWrBlMNWTfOXgQqUtb5,iv:j7LVT8mpG+eQcZhNsLziWUGq8iwIbrhO0yTinjMmLhI=,tag:pYTW+1P6Qe3XcDN4lhHxSA==,type:str]
MINIO_ROOT_PASSWORD=ENC[AES256_GCM,data:2WNVu9fIqUQ7OUaMzKajOCPhJngJqjzyU4y8HlGqY8qwnmj97NblNeCrChJZ1HyJ,iv:MqOyfLrRdtwf6NeHjQhdYMoyVRLXh0ZlHF2ZLrSekb0=,tag:eR9AmH9fvRskaBmhh2rqlQ==,type:str]
S3_BUCKET=formly
# ════════════════════════════════════════════════════════════
# ONLYOFFICE
# ════════════════════════════════════════════════════════════
# Generate: openssl rand -hex 32
ONLYOFFICE_JWT_SECRET=ENC[AES256_GCM,data:WBHBmNBa3g+9923esz5t/UjUfLGDDC4N0cDWNM7ga1c2WzHGQIGoBKy/vhpBvc8rzi7Pc7RB6iPk30U6ziYTdg==,iv:rG55EJ4FstEPCXpmUr2ffn3j6NitBvJ7Hp60pVIW3Zo=,tag:pACPofv8iAabnGxQ4DzlSw==,type:str]
# ════════════════════════════════════════════════════════════
# AI  (set AI_ENABLED=true after pulling models)
# ════════════════════════════════════════════════════════════
AI_ENABLED=false
AI_PROVIDER=ollama
AI_BASE_URL=http://ollama:11434
AI_CHAT_MODEL=llama3.2:3b
AI_EMBED_MODEL=nomic-embed-text
AI_VISION_MODEL=
AI_TIMEOUT_SEC=180
DOCCHAT_TIMEOUT_SEC=180
# ════════════════════════════════════════════════════════════
# OPTIONAL  — set if browsers upload directly to MinIO via
# presigned URLs. Leave blank to use the API-proxied path.

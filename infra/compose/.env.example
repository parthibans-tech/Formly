# Drive360 compose .env — copy to .env on the VPS and fill in real
# values. Loaded automatically by `docker compose` from the same
# directory as docker-compose.yml.
#
# CHMOD THIS FILE 600 — it contains every secret in the system.

# ════════════════════════════════════════════════════════════
# DOMAINS  (must have DNS A records pointing at this VPS)
# ════════════════════════════════════════════════════════════
DOMAIN_WEB=drive360.nearbyme.app
DOMAIN_API=api.drive360.nearbyme.app

# Optional — only set if you want public access via nginx. Leave
# blank to skip the corresponding nginx server block.
DOMAIN_OFFICE=
DOMAIN_S3=

# ════════════════════════════════════════════════════════════
# CONTAINER IMAGES  (rewritten by CI on every deploy)
# ════════════════════════════════════════════════════════════
# These default to :latest from your registry. CI pins them to a
# specific tag (e.g. ghcr.io/you/drive360-api:1.0.5) and writes the
# values into this file before `docker compose up -d`.
API_IMAGE=ghcr.io/your-github-username/drive360-api:latest
WEB_IMAGE=ghcr.io/your-github-username/drive360-web:latest
IMAGE_TAG=latest

# ════════════════════════════════════════════════════════════
# DATABASE
# ════════════════════════════════════════════════════════════
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM

# ════════════════════════════════════════════════════════════
# AUTH
# ════════════════════════════════════════════════════════════
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_64_HEX_CHARS

# ════════════════════════════════════════════════════════════
# OBJECT STORAGE  (MinIO)
# ════════════════════════════════════════════════════════════
# Generate user: openssl rand -hex 12
# Generate pass: openssl rand -hex 24
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_RANDOM
S3_BUCKET=drive360

# ════════════════════════════════════════════════════════════
# ONLYOFFICE
# ════════════════════════════════════════════════════════════
# Generate: openssl rand -hex 32
ONLYOFFICE_JWT_SECRET=CHANGE_ME_64_HEX_CHARS

# ════════════════════════════════════════════════════════════
# AI  (set AI_ENABLED=true after pulling models)
# ════════════════════════════════════════════════════════════
AI_ENABLED=false
AI_PROVIDER=ollama
AI_BASE_URL=http://ollama:11434
AI_CHAT_MODEL=llama3.2:3b
AI_EMBED_MODEL=nomic-embed-text
AI_VISION_MODEL=
AI_TIMEOUT_SEC=180
DOCCHAT_TIMEOUT_SEC=180

# ════════════════════════════════════════════════════════════
# OPTIONAL  — set if browsers upload directly to MinIO via
# presigned URLs. Leave blank to use the API-proxied path.
# ════════════════════════════════════════════════════════════
PUBLIC_STORAGE_URL=

# ════════════════════════════════════════════════════════════
# CORS  — browser origins allowed to call the API. Comma-separated,
# no trailing slashes. Defaults to https://${DOMAIN_WEB} when unset.
# ════════════════════════════════════════════════════════════
CORS_ALLOWED_ORIGINS=
